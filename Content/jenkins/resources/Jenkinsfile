pipeline {
    agent any
    environment {
        PYTHONUNBUFFERED = '1'
    }
    stages {
        stage('Setup') {
            steps {
                sh 'pip install -U uiautomator2 adbutils'
            }
        }
        stage('Initialize Device') {
            steps {
                sh 'python3 scripts/init_device.py'
            }
        }
        stage('Open Chrome') {
            steps {
                sh 'python3 scripts/open_chrome.py'
            }
        }
        stage('Open YouTube') {
            steps {
                sh 'python3 scripts/open_youtube.py'
            }
        }
        stage('Swipe Down') {
            steps {
                sh 'python3 scripts/swipe_down.py'
            }
        }
    }
}
